# # Salin file ini menjadi .env sebelum menjalankan docker compose
# TARGET_API_BASE_URL=http://target-api:3000
# OLLAMA_BASE_URL=http://ollama:11434
# MODEL_NAME=qwen2.5-coder:7b
# MAX_STEPS=15

# # AGENT_MODE: "neutral" untuk uji konektivitas (Fase 4),
# #             "assessment" untuk pengujian Excessive Data Exposure & BOLA
# AGENT_MODE=neutral

# # Hanya dibutuhkan saat AGENT_MODE=assessment:
# # - OWN_JWT_TOKEN: token hasil login akun pengujian Anda sendiri
# #                  (lihat langkah login di README)
# # - TARGET_PHONE : nomor telepon user lain (dummy) yang ingin diuji
# OWN_JWT_TOKEN=
# TARGET_PHONE=081200000002
# # Salin file ini menjadi .env sebelum menjalankan docker compose
PORT=3000
JWT_SECRET=devsecret_ganti_ini_untuk_lab_anda
DB_PATH=./data/lab.sqlite3

# SECURITY_MODE: "vulnerable" (default) atau "secure"
# - vulnerable: endpoint /api/users/search & /api/locations/:userId/latest
#               rentan (Excessive Data Exposure & BOLA) -- untuk Fase 5-6
# - secure    : kedua endpoint sudah dimitigasi (DTO/allowlist +
#               object-level access control) -- untuk Fase 7 (evaluasi
#               "sebelum vs sesudah")
SECURITY_MODE=vulnerable
